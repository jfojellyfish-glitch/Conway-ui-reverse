# Set these in .env.local and on the Render preview service.
# Must point to the SAME Supabase project as the existing Zen Trading login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin used for OAuth callbacks on Render.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Do not commit the service_role key. Configure Google OAuth allowed redirects in Supabase.
